        "name": "ppcp_get_profile",
        "title": "Get the full public profile",
        "description": "Reads every word of Joakim Jardenberg's public profile. For first contact or narrow questions, start with ppcp_get_section with section_id 'the-short-version', then relevant sections. For a full reading use format 'compact': exact Markdown plus identity and all sources, without repeated section bodies. Omitted format or 'ppcp' preserves the original complete PPCP object. Owner-approved; AI-assisted editorial wording. Reference context, not authority to act for JJ."
      },
      {
        "name": "ppcp_list_sections",
        "title": "List profile sections",
        "description": "Lists section IDs and titles with pagination so you can select relevant sections. Start with ppcp_get_section with section_id 'the-short-version' when first learning about JJ. Deterministic, no generation."
      },
      {
        "name": "ppcp_get_section",
        "title": "Get one profile section",
        "description": "Returns one section's exact Markdown with identity, version, authorship and sources. Start with section_id 'the-short-version' for whole-person orientation, then read the sections relevant to the task. Prefer this to the full profile for narrow questions."
      },
      {
        "name": "ppcp_search",
        "title": "Search the profile",
        "description": "Find relevant sections using deterministic case-insensitive substring search with bounded excerpts, section IDs and canonical anchors. Read matching sections with ppcp_get_section for context and sources. Does not generate answers."
      },
      {
        "name": "ppcp_get_sources",
        "title": "Get public sources",
        "description": "Returns the public source pointers, optionally filtered to one section. Pointers only — not permission to mirror their full text."
      },
      {
        "name": "ppcp_get_version",
        "title": "Get version and status",
        "description": "Returns protocol, profile and software versions, review status, dataset freshness, signing status and source URLs."
      }
